#!/usr/bin/env python3
"""Repository entry point for the read-only Control monitor."""
from pathlib import Path
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent / 'dev/codex/control'))
from specroad_control.monitor import main

if __name__ == '__main__':
    raise SystemExit(main())
