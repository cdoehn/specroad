  ],
  "preconditions": [
    "One explicitly supplied immutable XML byte document and native per-document hard limits; no project writer or external resolver."
  ],
  "steps": [
    "Read complete suites and testcases with the documented children and attributes, retaining original bytes/hash and reported strings without evaluating outcomes.",
    "Reject DTD/entity declarations, external schema/include requests, processing instructions, malformed XML and violated limits without file/network/process access.",
    "Check exact boundary acceptance, immutable result ownership, opaque extensions and matching isolated Core/PYZ behavior.",
    "Reject recursive, quadratic and exponential entity declarations before interpreting the DTD subset; reject schema/include references and processing instructions even inside opaque extensions.",
    "Enforce combined namespace-declaration/attribute limits and cumulative expanded-name budgets at exact boundaries; retain literal CDATA and comment content without false positives.",
    "Reject nonprofile declared encodings before extensible host codec lookup; prove all supported declarations and matching isolated Core/PYZ error contracts with file/network/process traps."
  ],
  "oracle": {
    "kind": "behavior",
    "requirement_contract": "Der XML-Import MUSS DTDs, externe Entitäten, externe Schemas und Netzwerkauflösung ablehnen sowie dokumentierte Grenzen für Tiefe, Elementanzahl, Textlänge und Gesamtbytes durchsetzen.",
    "scope": "12.f.W/R/C provides the bounded byte-only JUnit core reader. The common internal XML event reader owns input validation, parser protection, limits and error translation; the JUnit adapter owns only its documented profile and value assembly. Unmodified W/R tests preserve original bytes, reported content, errors and passive behavior, including ignored subtrees and Core/PYZ distributions. This remains a partial proof, not a complete import CLI, mapping, Evidence publication or ReqIF reader proof."
  },
  "expected_diagnostics": [
    "SRV083"
  ],
